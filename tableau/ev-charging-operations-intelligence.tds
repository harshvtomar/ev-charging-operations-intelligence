      <column name="[month]" caption="Month" datatype="string" role="dimension" type="nominal" />
      <column name="[segment]" caption="Segment" datatype="string" role="dimension" type="nominal" />
      <column name="[sessions]" caption="Sessions" datatype="real" role="measure" type="quantitative" />
      <column name="[successes]" caption="Successes" datatype="real" role="measure" type="quantitative" />
      <column name="[energy_kwh]" caption="Energy Kwh" datatype="real" role="measure" type="quantitative" />
      <column name="[revenue]" caption="Revenue" datatype="real" role="measure" type="quantitative" />
      <column name="[contribution]" caption="Contribution" datatype="real" role="measure" type="quantitative" />
      <column name="[planned_hours]" caption="Planned Hours" datatype="integer" role="measure" type="quantitative" />
      <column name="[available_hours]" caption="Available Hours" datatype="real" role="measure" type="quantitative" />
      <column name="[occupied_hours]" caption="Occupied Hours" datatype="real" role="measure" type="quantitative" />
      <column name="[month_date]" caption="Month Date" datatype="date" role="dimension" type="nominal" />
      <column name="[Calculation_KPI_0]" caption="Delivered energy" datatype="real" role="measure" type="quantitative" default-format="#,##0">
        <calculation class="tableau" formula="SUM([energy_kwh])" />
      </column>
      <column name="[Calculation_KPI_1]" caption="Session success" datatype="real" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="IF SUM([sessions]) = 0 THEN NULL ELSE SUM([successes]) / SUM([sessions]) END" />
      </column>
      <column name="[Calculation_KPI_2]" caption="Network uptime" datatype="real" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="IF SUM([planned_hours]) = 0 THEN NULL ELSE SUM([available_hours]) / SUM([planned_hours]) END" />
      </column>
      <column name="[Calculation_KPI_3]" caption="Contribution" datatype="real" role="measure" type="quantitative" default-format="$#,##0">
        <calculation class="tableau" formula="SUM([contribution])" />
      </column>
    </datasource>
  